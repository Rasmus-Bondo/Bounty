# Python build artifacts from the graph update scripts
__pycache__/
*.pyc

# Obsidian per-machine UI state (churns on every pane move)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache

# Local Claude Code overrides and their backups
.claude/settings.local.json
.claude/*.bak-*
.claude/**/*.bak-*

# Live per-session Studio-mutation capture. Transient, one file per running
# agent session, and rewritten constantly by concurrent sessions - tracking it
# would conflict on every commit. Retired captures in consumed/ and archive/
# ARE tracked: they are the audit trail behind each release entry.
.changelog/pending/

# graphify cache (regenerated by the skill)
graphify-out/cache/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
